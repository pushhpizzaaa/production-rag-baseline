# =====================================================================
# RAG BASELINE PIPELINE - ENVIRONMENT CONFIGURATION
# =====================================================================

# Application Configuration
APP_NAME="Production RAG Baseline Service"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"
LOG_LEVEL="INFO"

# Vector Store (Qdrant) Configuration
# To use embedded local storage, specify a directory path (e.g., .qdrant_data)
# To use Docker / Remote Qdrant server, set QDRANT_URL=http://localhost:6333
QDRANT_STORAGE_PATH="./.qdrant_data"
QDRANT_URL=""
QDRANT_API_KEY=""
COLLECTION_NAME="rag_baseline_corpus"

# Embedding Model Configuration
# Options: "BAAI/bge-small-en-v1.5" (FastEmbed default, 384 dim, fast & free)
#          "sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIM=384

# Chunker Configuration
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Retrieval Configuration
TOP_K=5
SCORE_THRESHOLD=0.35

# LLM Generation Provider Configuration (via LiteLLM)
# Set your preferred model: "gpt-4o-mini", "gemini/gemini-1.5-flash", "claude-3-haiku", etc.
# If no API key is provided, the pipeline gracefully falls back to a deterministic offline grounded generator.
LLM_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
